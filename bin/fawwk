#!/usr/bin/env bash
# Fawwk — deploy GitHub repos to Docker containers on your own Ubuntu server, with automatic HTTPS.
set -Eeuo pipefail

FAWWK_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export FAWWK_HOME

for _lib in common git env build proxy release setup create manage doctor; do
  # shellcheck disable=SC1090
  source "$FAWWK_HOME/lib/$_lib.sh"
done
unset _lib

usage() {
  cat <<EOF
${C_BOLD}Fawwk${C_RESET} v$FAWWK_VERSION: deploy git repos to containers on this server

${C_BOLD}Server${C_RESET}
  setup                         Prepare this server (run once, safe to re-run)
  doctor                        Check the server, DNS and every app
  proxy [status|reload|logs|config]
  update                        Update Fawwk itself

${C_BOLD}Apps${C_RESET}
  create [name]                 Connect a repo and deploy it (guided)
  deploy <app>                  Pull the latest commit and redeploy
  list                          All apps and their state
  info <app>                    Details for one app
  logs <app> [-f] [-n N] [--build]
  restart | stop | start <app>
  rollback <app> [deploy-id]    Go back to an earlier version
  history <app>                 Recent deploys
  exec <app> [command]          Shell (or a command) inside the container
  remove <app> [--yes]          Delete an app

${C_BOLD}Settings${C_RESET}
  env <app> [show|set|unset|import|edit|check]
  domain <app> [list|add|rm] [domain[/path]]
  port <app> [port]
  health <app> [path|off]
  autodeploy <app> [on|off]

Run ${C_BOLD}fawwk <command> --help${C_RESET} for details. Most commands need sudo.
EOF
}

main() {
  local cmd=${1:-help}
  (($#)) && shift
  case $cmd in
    setup) cmd_setup "$@" ;;
    create | new | add) cmd_create "$@" ;;
    deploy | redeploy) cmd_deploy "$@" ;;
    list | ls | ps) cmd_list "$@" ;;
    info | show | status) cmd_info "$@" ;;
    logs | log) cmd_logs "$@" ;;
    restart) cmd_restart "$@" ;;
    stop) cmd_stop "$@" ;;
    start) cmd_start "$@" ;;
    rollback) cmd_rollback "$@" ;;
    history) cmd_history "$@" ;;
    exec | shell | sh) cmd_exec "$@" ;;
    remove | rm | delete | destroy) cmd_remove "$@" ;;
    env) cmd_env "$@" ;;
    domain | domains) cmd_domain "$@" ;;
    port) cmd_port "$@" ;;
    health) cmd_health "$@" ;;
    autodeploy | auto) cmd_autodeploy "$@" ;;
    sync) cmd_sync "$@" ;;
    proxy) cmd_proxy "$@" ;;
    doctor | check) cmd_doctor "$@" ;;
    update | self-update) cmd_update "$@" ;;
    version | -v | --version) echo "$FAWWK_VERSION" ;;
    help | -h | --help) usage ;;
    *) err "Unknown command: $cmd"; usage >&2; exit 1 ;;
  esac
}

main "$@"
